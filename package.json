{
  "name": "chezcar-ui-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --no-file-parallelism",
    "data:profile": "node scripts/data-onboarding/workbook-profile.mjs",
    "data:generate": "node scripts/data-onboarding/generate-seed.mjs",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:catalog:reload": "node prisma/seed.mjs --catalog-only",
    "db:data:reset": "node --env-file=.env prisma/reset-operational-data.mjs",
    "verify:phase-01": "node scripts/verify-phase-01.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@prisma/client": "6.12.0",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.96.1",
    "better-auth": "1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "16.3.2",
    "pg": "^8.23.0",
    "prisma": "6.12.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-select": "^5.10.2",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.79",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/web-push": "^3.6.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "^5.8.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  }
}
