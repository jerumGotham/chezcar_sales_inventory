DATABASE_URL="postgresql://postgres:postgres@localhost:5435/chezcar_db?schema=public"
RECEIPT_STORAGE_PATH="./data/receipt-photos"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.invalid"

# Required only when running npm run db:seed to provision the first Admin.
SEED_ADMIN_EMAIL="admin@example.invalid"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
SEED_ADMIN_NAME="Chezcar Admin"

# Never enable for the bind-mounted DATABASE_URL above. Catalog seed/reload accepts
# only the separately isolated development/test database identities documented in
# docs/DATABASE.md.
# ALLOW_CATALOG_RESET="true"

# Required only for npm run db:data:reset. The reset accepts only the isolated
# development/test database identities and preserves Users, auth, Products, and Locations.
# ALLOW_OPERATIONAL_DATA_RESET="true"
