DATABASE_URL="postgresql://postgres:postgres@localhost:5435/chezcar_db?schema=public"
RECEIPT_STORAGE_PATH="./data/receipt-photos"
PRODUCT_IMAGE_STORAGE_PATH="./data/product-images"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
# Optional comma-separated origins used to access this development server.
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000,http://192.168.1.14:3000"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.invalid"

# Required only when running npm run db:seed to provision the first Admin.
SEED_ADMIN_EMAIL="admin@example.invalid"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
SEED_ADMIN_NAME="Chezcar Admin"

# These opt-ins apply only to the exact local Compose database above. The commands
# still refuse production and unknown database URLs.
ALLOW_CATALOG_RESET="true"

# db:data:reset preserves Users/auth, Roles, Products, and Locations.
ALLOW_OPERATIONAL_DATA_RESET="true"

# One-time production owner provisioning. Set these only in the execution
# environment, run npm run db:provision-owner once, then remove them.
# ALLOW_OWNER_PROVISIONING="true"
# PROVISION_OWNER_DATABASE="<exact-production-database-name>"
# PROVISION_OWNER_EMAIL="<owner-email>"
# PROVISION_OWNER_PASSWORD="<temporary-password-at-least-12-characters>"
# PROVISION_OWNER_NAME="<owner-display-name>"
