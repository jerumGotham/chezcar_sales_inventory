generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LocationType {
  WAREHOUSE
  BRANCH
}

enum UserRole {
  ADMIN
  STOCK_STAFF
  BRANCH_STAFF
  ACCOUNTING_STAFF
}

enum RoleScope {
  OWNER
  BRANCH
  STOCK_ROOM
  BUSINESS_WIDE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum PersonnelType {
  SALESPERSON
  INSTALLER
  BOTH
}

enum PersonnelStatus {
  ACTIVE
  INACTIVE
}

enum BackjobStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

enum BackjobCoverage {
  PENDING
  COVERED
  CHARGEABLE
}

enum BackjobAcknowledgementMethod {
  SIGNED
  VERBAL
  DECLINED
}

enum CustomerWarrantyStatus {
  ASSESSMENT
  APPROVED_REPAIR
  APPROVED_REPLACEMENT
  WAITING_STOCK
  READY
  RELEASED
  COMPLETED
  REJECTED
  CANCELLED
}

enum CustomerWarrantyResolution {
  REPAIR
  REPLACEMENT
}

enum SupplierClaimStatus {
  DRAFT
  PENDING
  WAITING_REPLACEMENT
  PARTIAL
  REPLACEMENT_RECEIVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum SupplierClaimReason {
  SUPPLIER_DAMAGE
}

enum SupplierClaimLineReason {
  DAMAGE
  DEFECT
  INCOMPLETE
  WRONG_ITEM
  WARRANTY
}

enum SupplierClaimSettlementType {
  REFUND
  CREDIT
}

enum StockTransferStatus {
  DRAFT
  FOR_DISPATCH
  IN_TRANSIT
  CANCELLED
  RECEIVED
  DISCREPANCY_REPORTED
  UNDER_REVIEW
  RESOLVED
}

enum InventoryMovementType {
  SUPPLIER_RECEIPT
  TRANSFER_DISPATCH
  TRANSFER_CANCELLATION
  TRANSFER_RECEIPT
  TRANSFER_RESTORATION
  TRANSFER_LOSS
  TRANSFER_RESOLUTION
  MANUAL_ADJUSTMENT
  CUSTOMER_ORDER_RELEASE
  DIRECT_SALE
  SALE_CORRECTION_REVERSAL
  SALE_CORRECTION
  BACKJOB_PART_ISSUE
  BACKJOB_PART_RETURN
  WARRANTY_RECEIPT
  WARRANTY_RELEASE
  SUPPLIER_CLAIM_RETURN
  SUPPLIER_CLAIM_REPAIR_SEND
  SUPPLIER_CLAIM_REPLACEMENT_RECEIPT
  SUPPLIER_CLAIM_REPAIRED_RECEIPT
  SUPPLIER_CLAIM_WRITEOFF
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum CustomerOrderStatus {
  RESERVED
  WAITING_STOCK
  READY_FOR_RELEASE
  COMPLETED
  CANCELLED
}

enum CustomerOrderType {
  RESERVATION_NO_DP
  RESERVATION_WITH_DP
  WAITING_STOCK
}

enum SaleStatus {
  POSTED
  VOIDED
}

enum PaymentMethod {
  CASH
  GCASH
  MAYA
  BANK_TRANSFER
  CREDIT_CARD
  SPLIT
}

enum AccountingReviewStatus {
  UNVERIFIED
  VERIFIED
  MISMATCH_REPORTED
}

enum AccountingResolutionAction {
  CONFIRMED_CORRECT
  VOIDED_REPLACED
  VOIDED
}

enum BranchMismatchResponse {
  ORIGINAL_ENCODING_CORRECT
  RECEIPT_CORRECTION_NEEDED
  WRONG_RECEIPT_PHOTO
  SALE_ENCODED_INCORRECT
}

enum SaleCorrectionRequestStatus {
  PENDING
  RESOLVED
}

enum SaleCorrectionRequestReason {
  ACCIDENTAL_SUBMISSION
  DUPLICATE_SUBMISSION
  WRONG_INFORMATION
  SALE_DID_NOT_HAPPEN
  OTHER
}

enum SaleCorrectionRequestResolution {
  KEPT
  VOIDED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
}

enum NotificationRelatedType {
  STOCK_TRANSFER
  INVENTORY_BALANCE
  SALE
  BACKJOB
  CUSTOMER_WARRANTY
  SUPPLIER_CLAIM
}

enum PushDeliveryStatus {
  SENT
  FAILED
}

enum OfflineDeviceStatus {
  ACTIVE
  REVOKED
}

enum OfflineSyncStatus {
  PENDING
  ACCEPTED
  ALREADY_ACCEPTED
  REJECTED
  NEEDS_REVIEW
  CONFLICT
}

model Location {
  id                   String              @id @default(cuid())
  code                 String              @unique
  name                 String
  type                 LocationType
  address              String?
  city                 String?
  contactNumber        String?
  email                String?
  notes                String?
  isActive             Boolean             @default(true)
  inventoryBalances    InventoryBalance[]
  users                User[]
  userAssignments      UserLocation[]
  destinationTransfers StockTransfer[]     @relation("TransferDestination")
  inventoryMovements   InventoryMovement[]
  stockReceipts        StockReceipt[]
  customerOrders       CustomerOrder[]
  sales                Sale[]
  manualReceipts       ManualReceipt[]
  personnel            Personnel[]
  backjobs             Backjob[]
  customerWarranties   CustomerWarranty[]
  supplierClaims       SupplierClaim[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model Product {
  id                     String                        @id @default(cuid())
  itemCode               String                        @unique
  name                   String
  description            String?
  category               String?
  brand                  String?
  imageKey               String?                       @unique
  imageType              String?
  price                  Decimal?                      @db.Decimal(12, 2)
  reorderLevel           Int                           @default(0)
  warrantyDurationMonths Int?
  status                 ProductStatus                 @default(ACTIVE)
  inventoryBalances      InventoryBalance[]
  transferLines          StockTransferLine[]
  receiptLines           StockReceiptLine[]
  inventoryMovements     InventoryMovement[]
  customerOrderLines     CustomerOrderLine[]
  saleLines              SaleLine[]
  affectedBackjobs       Backjob[]                     @relation("BackjobAffectedProduct")
  backjobItems           BackjobItem[]
  backjobParts           BackjobPart[]
  warrantyClaims         CustomerWarranty[]            @relation("WarrantyClaimProduct")
  warrantyReplacements   CustomerWarranty[]            @relation("WarrantyReplacementProduct")
  supplierClaimLines     SupplierClaimLine[]
  vehicleCompatibilities ProductVehicleCompatibility[]
  createdById            String?
  updatedById            String?
  deactivatedById        String?
  reactivatedById        String?
  createdBy              User?                         @relation("ProductCreatedBy", fields: [createdById], references: [id])
  updatedBy              User?                         @relation("ProductUpdatedBy", fields: [updatedById], references: [id])
  deactivatedBy          User?                         @relation("ProductDeactivatedBy", fields: [deactivatedById], references: [id])
  reactivatedBy          User?                         @relation("ProductReactivatedBy", fields: [reactivatedById], references: [id])
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt

  @@index([createdById])
  @@index([updatedById])
  @@index([deactivatedById])
  @@index([reactivatedById])
}

model Supplier {
  id              String         @id @default(cuid())
  code            String?
  name            String
  contactPerson   String?
  contactNumber   String?
  email           String?
  address         String?
  notes           String?        @db.Text
  status          SupplierStatus @default(ACTIVE)
  createdById     String?
  updatedById     String?
  deactivatedById String?
  reactivatedById String?
  createdBy       User?          @relation("SupplierCreatedBy", fields: [createdById], references: [id])
  updatedBy       User?          @relation("SupplierUpdatedBy", fields: [updatedById], references: [id])
  deactivatedBy   User?          @relation("SupplierDeactivatedBy", fields: [deactivatedById], references: [id])
  reactivatedBy   User?          @relation("SupplierReactivatedBy", fields: [reactivatedById], references: [id])
  stockReceipts   StockReceipt[]
  supplierClaims  SupplierClaim[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, name])
  @@index([createdById])
  @@index([updatedById])
  @@index([deactivatedById])
  @@index([reactivatedById])
}

model Personnel {
  id              String          @id @default(cuid())
  fullName        String
  locationId      String
  type            PersonnelType
  status          PersonnelStatus @default(ACTIVE)
  location        Location        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdById     String?
  updatedById     String?
  deactivatedById String?
  reactivatedById String?
  createdBy       User?           @relation("PersonnelCreatedBy", fields: [createdById], references: [id])
  updatedBy       User?           @relation("PersonnelUpdatedBy", fields: [updatedById], references: [id])
  deactivatedBy   User?           @relation("PersonnelDeactivatedBy", fields: [deactivatedById], references: [id])
  reactivatedBy   User?           @relation("PersonnelReactivatedBy", fields: [reactivatedById], references: [id])
  customerOrders  CustomerOrder[]
  sales           Sale[]
  backjobs        Backjob[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([locationId, status, fullName])
  @@index([createdById])
  @@index([updatedById])
  @@index([deactivatedById])
  @@index([reactivatedById])
}

model ProductVehicleCompatibility {
  id        String   @id @default(cuid())
  productId String
  make      String?
  model     String
  startYear Int?
  endYear   Int?
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([make])
  @@index([model])
  @@index([startYear, endYear])
}

model InventoryBalance {
  id         String   @id @default(cuid())
  locationId String
  productId  String
  onHand     Int      @default(0)
  reserved   Int      @default(0)
  quarantined Int     @default(0)
  unitCost   Decimal  @default(0) @db.Decimal(12, 2)
  version    Int      @default(1)
  location   Location @relation(fields: [locationId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([locationId, productId])
  @@index([productId])
}

model CustomerWarranty {
  id                       String                     @id @default(cuid())
  reference                String                     @unique
  idempotencyKey           String                     @unique
  requestHash              String?
  version                  Int                        @default(1)
  status                   CustomerWarrantyStatus     @default(ASSESSMENT)
  resolution               CustomerWarrantyResolution?
  locationId               String
  customerId               String?
  saleId                   String?
  saleLineId               String?
  productId                String?
  replacementProductId     String?
  isLegacy                 Boolean                    @default(false)
  legacyCustomerName       String?
  legacySaleReference      String?
  legacyReason             String?                    @db.Text
  customerName             String
  locationCode             String
  locationName             String
  saleReference            String?
  receiptNumber            String?
  productItemCode          String
  productName              String
  soldQuantity             Int?
  warrantyDurationMonths   Int?
  warrantyExpiresAt        DateTime?
  claimQuantity            Int
  receivedQuantity         Int                        @default(0)
  returnedQuantity         Int                        @default(0)
  concern                  String                     @db.Text
  assessmentNotes          String?                    @db.Text
  replacementReason        String?                    @db.Text
  replacementItemCode      String?
  replacementProductName   String?
  intakePhotoKey           String?                    @unique
  intakePhotoType          String?
  intakePhotoName          String?
  receivedAt               DateTime?
  targetDate               DateTime?
  readyAt                  DateTime?
  releasedAt               DateTime?
  completedAt              DateTime?
  createdById              String
  location                 Location                   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  customer                 Customer?                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sale                     Sale?                      @relation(fields: [saleId], references: [id], onDelete: Restrict)
  saleLine                 SaleLine?                  @relation(fields: [saleLineId], references: [id], onDelete: Restrict)
  product                  Product?                   @relation("WarrantyClaimProduct", fields: [productId], references: [id], onDelete: Restrict)
  replacementProduct       Product?                   @relation("WarrantyReplacementProduct", fields: [replacementProductId], references: [id], onDelete: Restrict)
  createdBy                User                       @relation("WarrantyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  events                   CustomerWarrantyEvent[]
  actions                  CustomerWarrantyAction[]
  movements                InventoryMovement[]
  supplierClaims           SupplierClaim[]
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  @@index([locationId, status, createdAt])
  @@index([targetDate, status])
  @@index([customerId, createdAt])
  @@index([saleLineId])
}

model CustomerWarrantyEvent {
  id          String                  @id @default(cuid())
  warrantyId  String
  type        String
  fromStatus  CustomerWarrantyStatus?
  toStatus    CustomerWarrantyStatus?
  detailsJson Json?
  actorId     String
  occurredAt  DateTime                @default(now())
  warranty    CustomerWarranty        @relation(fields: [warrantyId], references: [id], onDelete: Restrict)
  actor       User                    @relation("WarrantyEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([warrantyId, occurredAt])
}

model CustomerWarrantyAction {
  id             String           @id @default(cuid())
  warrantyId     String
  idempotencyKey String
  action         String
  requestHash    String
  actorId        String
  createdAt      DateTime         @default(now())
  warranty       CustomerWarranty @relation(fields: [warrantyId], references: [id], onDelete: Restrict)
  actor          User             @relation("WarrantyActionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([warrantyId, idempotencyKey])
  @@index([actorId, createdAt])
}

model Backjob {
  id                            String                        @id @default(cuid())
  reference                     String                        @unique
  version                       Int                           @default(1)
  status                        BackjobStatus                 @default(DRAFT)
  coverage                      BackjobCoverage               @default(PENDING)
  locationId                    String
  customerId                    String
  originalSaleId                String?
  originalSaleLineId            String?
  affectedProductId             String?
  chargeSaleId                  String?
  isLegacy                      Boolean                       @default(false)
  legacyReference               String?
  legacyReason                  String?                       @db.Text
  legacyProductDescription      String?
  originalSaleReference         String?
  originalReceiptNumber         String?
  customerName                  String
  customerMobile                String?
  affectedProductItemCode       String?
  affectedProductName           String?
  locationCode                  String
  locationName                  String
  concern                       String                        @db.Text
  notes                         String?                       @db.Text
  installerId                   String?
  installerName                 String?
  installerLocationId           String?
  installerLocationCode         String?
  installerLocationName         String?
  scheduledFor                  DateTime?
  workPerformed                 String?                       @db.Text
  completionNotes               String?                       @db.Text
  chargeableAmount              Decimal                       @default(0) @db.Decimal(12, 2)
  acknowledgementMethod         BackjobAcknowledgementMethod?
  acknowledgedByName            String?
  acknowledgementNote           String?                       @db.Text
  acknowledgedAt                DateTime?
  createdById                   String
  updatedById                   String?
  completedById                 String?
  cancelledById                 String?
  rejectedById                  String?
  completedAt                   DateTime?
  cancelledAt                   DateTime?
  rejectedAt                    DateTime?
  location                      Location                      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  customer                      Customer                      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  originalSale                  Sale?                         @relation("BackjobOriginalSale", fields: [originalSaleId], references: [id], onDelete: Restrict)
  originalSaleLine              SaleLine?                     @relation(fields: [originalSaleLineId], references: [id], onDelete: Restrict)
  affectedProduct               Product?                      @relation("BackjobAffectedProduct", fields: [affectedProductId], references: [id], onDelete: Restrict)
  chargeSale                    Sale?                         @relation("BackjobChargeSale", fields: [chargeSaleId], references: [id], onDelete: Restrict)
  installer                     Personnel?                    @relation(fields: [installerId], references: [id], onDelete: Restrict)
  createdBy                     User                          @relation("BackjobCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy                     User?                         @relation("BackjobUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  completedBy                   User?                         @relation("BackjobCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  cancelledBy                   User?                         @relation("BackjobCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  rejectedBy                    User?                         @relation("BackjobRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict)
  items                         BackjobItem[]
  parts                         BackjobPart[]
  events                        BackjobEvent[]
  schedules                     BackjobScheduleHistory[]
  attachments                   BackjobAttachment[]
  createdAt                     DateTime                      @default(now())
  updatedAt                     DateTime                      @updatedAt

  @@index([locationId, status, scheduledFor])
  @@index([customerId, createdAt])
  @@index([originalSaleId])
  @@index([originalSaleLineId])
  @@index([installerId, status])
}

model BackjobItem {
  id                 String   @id @default(cuid())
  backjobId          String
  originalSaleLineId String?
  productId          String?
  productItemCode    String?
  productName        String
  position           Int
  backjob            Backjob  @relation(fields: [backjobId], references: [id], onDelete: Restrict)
  originalSaleLine   SaleLine? @relation(fields: [originalSaleLineId], references: [id], onDelete: Restrict)
  product            Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([backjobId, originalSaleLineId])
  @@unique([backjobId, position])
  @@index([originalSaleLineId])
  @@index([productId])
}

model BackjobPart {
  id               String              @id @default(cuid())
  backjobId        String
  productId        String
  productItemCode  String
  productName      String
  plannedQuantity  Int                 @default(0)
  issuedQuantity   Int                 @default(0)
  usedQuantity     Int?
  returnedQuantity Int                 @default(0)
  backjob          Backjob             @relation(fields: [backjobId], references: [id], onDelete: Restrict)
  product          Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  movements        InventoryMovement[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([backjobId, productId])
  @@index([productId])
}

model BackjobEvent {
  id         String        @id @default(cuid())
  backjobId  String
  type       String
  fromStatus BackjobStatus?
  toStatus   BackjobStatus?
  reason     String?       @db.Text
  detailsJson Json?
  actorId    String
  occurredAt DateTime      @default(now())
  backjob    Backjob       @relation(fields: [backjobId], references: [id], onDelete: Restrict)
  actor      User          @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([backjobId, occurredAt])
}

model BackjobScheduleHistory {
  id               String   @id @default(cuid())
  backjobId        String
  previousSchedule DateTime?
  newSchedule      DateTime
  reason           String?  @db.Text
  actorId          String
  recordedAt       DateTime @default(now())
  backjob          Backjob  @relation(fields: [backjobId], references: [id], onDelete: Restrict)
  actor             User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([backjobId, recordedAt])
}

model BackjobAttachment {
  id           String   @id @default(cuid())
  backjobId    String
  storageKey   String   @unique
  contentType  String
  fileName     String
  caption      String?
  uploadedById String
  uploadedAt   DateTime @default(now())
  backjob      Backjob  @relation(fields: [backjobId], references: [id], onDelete: Restrict)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([backjobId, uploadedAt])
}

model User {
  id                       String                       @id @default(cuid())
  name                     String
  email                    String                       @unique
  emailVerified            Boolean                      @default(false)
  image                    String?
  role                     UserRole                     @default(BRANCH_STAFF)
  roleDefinitionId         String
  accessRole               RoleDefinition               @relation(fields: [roleDefinitionId], references: [id], onDelete: Restrict)
  /// Application activation is governed only by status. Lifecycle services keep the plugin ban fields false/null.
  status                   UserStatus                   @default(ACTIVE)
  credentialSetupRequired  Boolean                      @default(false)
  banned                   Boolean                      @default(false)
  banReason                String?
  banExpires               DateTime?
  locationId               String?
  location                 Location?                    @relation(fields: [locationId], references: [id])
  locationAssignments      UserLocation[]
  sessions                 Session[]
  accounts                 Account[]
  createdTransfers         StockTransfer[]              @relation("TransferCreatedBy")
  finalizedTransfers       StockTransfer[]              @relation("TransferFinalizedBy")
  dispatchedTransfers      StockTransfer[]              @relation("TransferDispatchedBy")
  cancelledTransfers       StockTransfer[]              @relation("TransferCancelledBy")
  receivedTransfers        StockTransfer[]              @relation("TransferReceivedBy")
  discrepancyReports       StockTransferDiscrepancy[]   @relation("DiscrepancyReportedBy")
  investigations           StockTransferInvestigation[] @relation("InvestigationSubmittedBy")
  resolutions              StockTransferResolution[]    @relation("ResolutionPostedBy")
  inventoryMovements       InventoryMovement[]
  stockReceipts            StockReceipt[]               @relation("ReceiptReceivedBy")
  notifications            Notification[]
  createdCustomers         Customer[]                   @relation("CustomerCreatedBy")
  createdCustomerOrders    CustomerOrder[]              @relation("CustomerOrderCreatedBy")
  releasedCustomerOrders   CustomerOrder[]              @relation("CustomerOrderReleasedBy")
  cancelledCustomerOrders  CustomerOrder[]              @relation("CustomerOrderCancelledBy")
  salespersonUpdatedOrders CustomerOrder[]               @relation("CustomerOrderSalespersonUpdatedBy")
  customerOrderSalespersonEvents CustomerOrderSalespersonEvent[] @relation("CustomerOrderSalespersonEventActor")
  postedSales              Sale[]                       @relation("SalePostedBy")
  reviewedSales            SaleAccountingReview[]       @relation("SaleReviewedBy")
  branchMismatchResponses  SaleAccountingReview[]       @relation("SaleBranchRespondedBy")
  requestedSaleCorrections SaleCorrectionRequest[]      @relation("SaleCorrectionRequestedBy")
  resolvedSaleCorrections  SaleCorrectionRequest[]      @relation("SaleCorrectionResolvedBy")
  correctedSales           Sale[]                       @relation("SaleCorrectedBy")
  resolvedReviews          SaleAccountingReview[]       @relation("SaleResolvedBy")
  createdProducts          Product[]                    @relation("ProductCreatedBy")
  updatedProducts          Product[]                    @relation("ProductUpdatedBy")
  deactivatedProducts      Product[]                    @relation("ProductDeactivatedBy")
  reactivatedProducts      Product[]                    @relation("ProductReactivatedBy")
  createdSuppliers         Supplier[]                   @relation("SupplierCreatedBy")
  updatedSuppliers         Supplier[]                   @relation("SupplierUpdatedBy")
  deactivatedSuppliers     Supplier[]                   @relation("SupplierDeactivatedBy")
  reactivatedSuppliers     Supplier[]                   @relation("SupplierReactivatedBy")
  createdPersonnel         Personnel[]                  @relation("PersonnelCreatedBy")
  updatedPersonnel         Personnel[]                  @relation("PersonnelUpdatedBy")
  deactivatedPersonnel     Personnel[]                  @relation("PersonnelDeactivatedBy")
  reactivatedPersonnel     Personnel[]                  @relation("PersonnelReactivatedBy")
  createdBackjobs          Backjob[]                    @relation("BackjobCreatedBy")
  updatedBackjobs          Backjob[]                    @relation("BackjobUpdatedBy")
  completedBackjobs        Backjob[]                    @relation("BackjobCompletedBy")
  cancelledBackjobs        Backjob[]                    @relation("BackjobCancelledBy")
  rejectedBackjobs         Backjob[]                    @relation("BackjobRejectedBy")
  backjobEvents            BackjobEvent[]
  backjobSchedules         BackjobScheduleHistory[]
  backjobAttachments       BackjobAttachment[]
  createdWarranties        CustomerWarranty[]           @relation("WarrantyCreatedBy")
  warrantyEvents           CustomerWarrantyEvent[]      @relation("WarrantyEventActor")
  warrantyActions          CustomerWarrantyAction[]     @relation("WarrantyActionActor")
  createdSupplierClaims    SupplierClaim[]               @relation("SupplierClaimCreatedBy")
  supplierClaimActions     SupplierClaimAction[]         @relation("SupplierClaimActionActor")
  supplierClaimEvidence    SupplierClaimEvidence[]       @relation("SupplierClaimEvidenceActor")
  supplierClaimSettlements SupplierClaimSettlement[]     @relation("SupplierClaimSettlementActor")
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  @@index([locationId])
  @@index([roleDefinitionId])
}

model RoleDefinition {
  id          String    @id @default(cuid())
  key         String    @unique
  name        String
  description String    @db.Text
  scope       RoleScope
  permissions String[]  @default([])
  isOwner     Boolean   @default(false)
  isSystem    Boolean   @default(false)
  version     Int       @default(1)
  users       User[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([scope])
}

model UserLocation {
  userId     String
  locationId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, locationId])
  @@index([locationId])
}

model StockTransfer {
  id                 String                      @id @default(cuid())
  reference          String                      @unique
  destinationId      String
  status             StockTransferStatus         @default(DRAFT)
  version            Int                         @default(1)
  createdById        String
  finalizedById      String?
  dispatchedById     String?
  cancelledById      String?
  receivedById       String?
  finalizedAt        DateTime?
  dispatchedAt       DateTime?
  cancelledAt        DateTime?
  cancellationReason String?                     @db.Text
  receivedAt         DateTime?
  destination        Location                    @relation("TransferDestination", fields: [destinationId], references: [id])
  createdBy          User                        @relation("TransferCreatedBy", fields: [createdById], references: [id])
  finalizedBy        User?                       @relation("TransferFinalizedBy", fields: [finalizedById], references: [id])
  dispatchedBy       User?                       @relation("TransferDispatchedBy", fields: [dispatchedById], references: [id])
  cancelledBy        User?                       @relation("TransferCancelledBy", fields: [cancelledById], references: [id])
  receivedBy         User?                       @relation("TransferReceivedBy", fields: [receivedById], references: [id])
  lines              StockTransferLine[]
  discrepancy        StockTransferDiscrepancy?
  investigation      StockTransferInvestigation?
  resolution         StockTransferResolution?
  movements          InventoryMovement[]
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@index([destinationId, status])
  @@index([status])
}

model StockTransferLine {
  id                 String                         @id @default(cuid())
  transferId         String
  productId          String
  requestedQuantity  Int
  dispatchedQuantity Int                            @default(0)
  inTransitQuantity  Int                            @default(0)
  transfer           StockTransfer                  @relation(fields: [transferId], references: [id], onDelete: Restrict)
  product            Product                        @relation(fields: [productId], references: [id])
  discrepancyLines   StockTransferDiscrepancyLine[]
  resolutionLines    StockTransferResolutionLine[]

  @@unique([transferId, productId])
}

model StockTransferDiscrepancy {
  id           String                         @id @default(cuid())
  transferId   String                         @unique
  reportedById String
  notes        String                         @db.Text
  reportedAt   DateTime                       @default(now())
  transfer     StockTransfer                  @relation(fields: [transferId], references: [id], onDelete: Restrict)
  reportedBy   User                           @relation("DiscrepancyReportedBy", fields: [reportedById], references: [id])
  lines        StockTransferDiscrepancyLine[]
}

model StockTransferDiscrepancyLine {
  id             String                   @id @default(cuid())
  discrepancyId  String
  transferLineId String
  actualQuantity Int
  reason         String
  notes          String?                  @db.Text
  discrepancy    StockTransferDiscrepancy @relation(fields: [discrepancyId], references: [id], onDelete: Restrict)
  transferLine   StockTransferLine        @relation(fields: [transferLineId], references: [id])

  @@unique([discrepancyId, transferLineId])
}

model StockTransferInvestigation {
  id            String        @id @default(cuid())
  transferId    String        @unique
  submittedById String
  findings      String        @db.Text
  submittedAt   DateTime      @default(now())
  transfer      StockTransfer @relation(fields: [transferId], references: [id], onDelete: Restrict)
  submittedBy   User          @relation("InvestigationSubmittedBy", fields: [submittedById], references: [id])
}

model StockTransferResolution {
  id         String                        @id @default(cuid())
  transferId String                        @unique
  postedById String
  notes      String                        @db.Text
  postedAt   DateTime                      @default(now())
  transfer   StockTransfer                 @relation(fields: [transferId], references: [id], onDelete: Restrict)
  postedBy   User                          @relation("ResolutionPostedBy", fields: [postedById], references: [id])
  lines      StockTransferResolutionLine[]
}

model StockTransferResolutionLine {
  id             String                  @id @default(cuid())
  resolutionId   String
  transferLineId String
  destinationQty Int
  restoreToSrQty Int
  lossQty        Int
  resolution     StockTransferResolution @relation(fields: [resolutionId], references: [id], onDelete: Restrict)
  transferLine   StockTransferLine       @relation(fields: [transferLineId], references: [id])

  @@unique([resolutionId, transferLineId])
}

model StockReceipt {
  id           String              @id @default(cuid())
  reference    String              @unique
  supplierId   String
  supplierName String              @map("supplier")
  notes        String?             @db.Text
  locationId   String
  receivedById String
  receivedAt   DateTime            @default(now())
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  location     Location            @relation(fields: [locationId], references: [id])
  receivedBy   User                @relation("ReceiptReceivedBy", fields: [receivedById], references: [id])
  lines        StockReceiptLine[]
  movements    InventoryMovement[]
  supplierClaim SupplierClaim?

  @@index([locationId, receivedAt])
  @@index([receivedById])
  @@index([supplierId])
}

model StockReceiptLine {
  id              String       @id @default(cuid())
  receiptId       String
  productId       String
  quantity        Int
  acceptedQuantity Int
  quarantinedQuantity Int @default(0)
  missingQuantity Int @default(0)
  productItemCode String
  productName     String
  receipt         StockReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  product         Product      @relation(fields: [productId], references: [id])

  @@unique([receiptId, productId])
}

model SupplierClaim {
  id                 String              @id @default(cuid())
  reference          String              @unique
  idempotencyKey     String              @unique
  version            Int                 @default(1)
  reason             SupplierClaimReason @default(SUPPLIER_DAMAGE)
  status             SupplierClaimStatus @default(DRAFT)
  supplierId         String
  locationId         String
  sourceReceiptId    String?             @unique
  customerWarrantyId String?
  supplierName       String
  locationCode       String
  locationName       String
  notes              String?             @db.Text
  targetDate         DateTime?
  createdById        String
  submittedAt        DateTime?
  completedAt        DateTime?
  supplier           Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  location           Location            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  sourceReceipt      StockReceipt?        @relation(fields: [sourceReceiptId], references: [id], onDelete: Restrict)
  customerWarranty   CustomerWarranty?    @relation(fields: [customerWarrantyId], references: [id], onDelete: Restrict)
  createdBy          User                @relation("SupplierClaimCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lines              SupplierClaimLine[]
  actions            SupplierClaimAction[]
  evidence           SupplierClaimEvidence[]
  settlements        SupplierClaimSettlement[]
  movements          InventoryMovement[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([locationId, status, createdAt])
  @@index([targetDate, status])
  @@index([supplierId, createdAt])
  @@index([customerWarrantyId])
}

model SupplierClaimLine {
  id                    String                  @id @default(cuid())
  claimId               String
  productId             String
  reason                SupplierClaimLineReason
  claimedQuantity       Int
  quarantinedQuantity   Int
  missingQuantity       Int
  openQuarantinedQuantity Int
  openMissingQuantity   Int
  productItemCode       String
  productName           String
  unitCost              Decimal                 @db.Decimal(12, 2)
  notes                 String?                 @db.Text
  claim                 SupplierClaim           @relation(fields: [claimId], references: [id], onDelete: Restrict)
  product               Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([claimId, productId])
}

model SupplierClaimAction {
  id             String        @id @default(cuid())
  claimId        String
  idempotencyKey String
  action         String
  requestHash    String
  fromStatus     SupplierClaimStatus
  toStatus       SupplierClaimStatus
  detailsJson    Json?
  actorId        String
  createdAt      DateTime      @default(now())
  claim          SupplierClaim @relation(fields: [claimId], references: [id], onDelete: Restrict)
  actor          User          @relation("SupplierClaimActionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([claimId, idempotencyKey])
  @@index([claimId, createdAt])
}

model SupplierClaimEvidence {
  id          String        @id @default(cuid())
  claimId     String
  storageKey  String        @unique
  fileName    String
  contentType String
  size        Int
  caption     String?
  uploadedById String
  createdAt   DateTime      @default(now())
  claim       SupplierClaim @relation(fields: [claimId], references: [id], onDelete: Restrict)
  uploadedBy  User          @relation("SupplierClaimEvidenceActor", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([claimId, createdAt])
}

model SupplierClaimSettlement {
  id             String                      @id @default(cuid())
  claimId        String
  idempotencyKey String
  type           SupplierClaimSettlementType
  amount         Decimal                     @db.Decimal(12, 2)
  currency       String                      @default("PHP")
  reference      String
  notes          String?                     @db.Text
  actorId        String
  createdAt      DateTime                    @default(now())
  claim          SupplierClaim               @relation(fields: [claimId], references: [id], onDelete: Restrict)
  actor          User                        @relation("SupplierClaimSettlementActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([claimId, idempotencyKey])
  @@index([claimId, createdAt])
}

model InventoryMovement {
  id         String                @id @default(cuid())
  transferId String?
  receiptId  String?
  backjobPartId String?
  warrantyId String?
  supplierClaimId String?
  productId  String
  locationId String?
  quantity   Int
  type       InventoryMovementType
  actorId    String
  reference  String?
  remarks    String?               @db.Text
  occurredAt DateTime              @default(now())
  createdAt  DateTime              @default(now())
  serverRecordedAt DateTime?       @default(now())
  transfer   StockTransfer?        @relation(fields: [transferId], references: [id], onDelete: Restrict)
  receipt    StockReceipt?         @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  backjobPart BackjobPart?         @relation(fields: [backjobPartId], references: [id], onDelete: Restrict)
  warranty   CustomerWarranty?     @relation(fields: [warrantyId], references: [id], onDelete: Restrict)
  supplierClaim SupplierClaim?     @relation(fields: [supplierClaimId], references: [id], onDelete: Restrict)
  product    Product               @relation(fields: [productId], references: [id])
  location   Location?             @relation(fields: [locationId], references: [id])
  actor      User                  @relation(fields: [actorId], references: [id])

  @@index([transferId])
  @@index([receiptId])
  @@index([backjobPartId])
  @@index([warrantyId])
  @@index([supplierClaimId])
  @@index([productId, locationId])
  @@index([locationId, occurredAt])
  @@index([createdAt])
}

model Customer {
  id          String          @id @default(cuid())
  name        String
  mobile      String?
  email       String?
  address     String?
  source      String?
  notes       String?         @db.Text
  status      CustomerStatus  @default(ACTIVE)
  createdById String?
  createdBy   User?           @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  orders      CustomerOrder[]
  sales       Sale[]
  backjobs    Backjob[]
  warranties  CustomerWarranty[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([name])
  @@index([mobile])
  @@index([createdById])
}

model ManualReceipt {
  id             String    @id @default(cuid())
  number         String
  purpose        String
  orderId        String?
  saleId         String?
  locationId     String?
  receiptBooklet String    @default("")
  location       Location? @relation(fields: [locationId], references: [id])
  createdAt      DateTime  @default(now())

  @@unique([locationId, receiptBooklet, number])
  @@index([orderId])
  @@index([saleId])
  @@index([locationId])
}

model CustomerOrder {
  id                       String              @id @default(cuid())
  reference                String              @unique
  locationId               String
  customerId               String
  status                   CustomerOrderStatus @default(RESERVED)
  type                     CustomerOrderType
  downpaymentAmount        Decimal             @default(0) @db.Decimal(12, 2)
  downpaymentReceiptNumber String?             @unique
  finalReceiptNumber       String?             @unique
  totalAmount              Decimal             @db.Decimal(12, 2)
  remainingBalance         Decimal             @db.Decimal(12, 2)
  expectedReleaseDate      DateTime?
  source                   String?
  notes                    String?             @db.Text
  cancellationNote         String?             @db.Text
  createdById              String
  releasedById             String?
  cancelledById            String?
  salespersonId            String?
  salespersonName          String?
  salespersonLocationId    String?
  salespersonLocationCode  String?
  salespersonLocationName  String?
  salespersonUpdatedById   String?
  salespersonUpdatedAt     DateTime?
  releasedAt               DateTime?
  cancelledAt              DateTime?
  location                 Location            @relation(fields: [locationId], references: [id])
  customer                 Customer            @relation(fields: [customerId], references: [id])
  createdBy                User                @relation("CustomerOrderCreatedBy", fields: [createdById], references: [id])
  releasedBy               User?               @relation("CustomerOrderReleasedBy", fields: [releasedById], references: [id])
  cancelledBy              User?               @relation("CustomerOrderCancelledBy", fields: [cancelledById], references: [id])
  salesperson              Personnel?          @relation(fields: [salespersonId], references: [id], onDelete: Restrict)
  salespersonUpdatedBy     User?               @relation("CustomerOrderSalespersonUpdatedBy", fields: [salespersonUpdatedById], references: [id])
  salespersonEvents        CustomerOrderSalespersonEvent[]
  lines                    CustomerOrderLine[]
  sale                     Sale?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@index([locationId, status])
  @@index([customerId])
  @@index([createdById])
  @@index([salespersonId, createdAt])
  @@index([salespersonUpdatedById])
}

model CustomerOrderSalespersonEvent {
  id                            String        @id @default(cuid())
  orderId                       String
  previousSalespersonId         String?
  previousSalespersonName       String?
  previousSalespersonLocationId String?
  previousSalespersonLocationCode String?
  previousSalespersonLocationName String?
  newSalespersonId              String
  newSalespersonName            String
  newSalespersonLocationId      String
  newSalespersonLocationCode    String
  newSalespersonLocationName    String
  actorId                       String
  occurredAt                    DateTime      @default(now())
  order                         CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor                         User          @relation("CustomerOrderSalespersonEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([orderId, occurredAt])
}

model CustomerOrderLine {
  id              String        @id @default(cuid())
  orderId         String
  productId       String
  productItemCode String
  productName     String
  quantity        Int
  baseUnitPrice   Decimal       @db.Decimal(12, 2)
  finalUnitPrice  Decimal       @db.Decimal(12, 2)
  order           CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product         Product       @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Sale {
  id                  String                  @id @default(cuid())
  reference           String                  @unique
  manualReceiptNumber String
  receiptBooklet      String                  @default("")
  version             Int                     @default(1)
  locationId          String
  customerId          String?
  orderId             String?                 @unique
  correctionOfId      String?
  correctedById       String?
  correctedAt         DateTime?
  status              SaleStatus              @default(POSTED)
  paymentMethod       PaymentMethod
  totalAmount         Decimal                 @db.Decimal(12, 2)
  discountAmount      Decimal                 @default(0) @db.Decimal(12, 2)
  amountPaid          Decimal                 @db.Decimal(12, 2)
  notes               String?                 @db.Text
  postedById          String
  salespersonId       String?
  salespersonName     String?
  salespersonLocationId String?
  salespersonLocationCode String?
  salespersonLocationName String?
  postedAt            DateTime                @default(now())
  location            Location                @relation(fields: [locationId], references: [id])
  customer            Customer?               @relation(fields: [customerId], references: [id])
  order               CustomerOrder?          @relation(fields: [orderId], references: [id])
  postedBy            User                    @relation("SalePostedBy", fields: [postedById], references: [id])
  salesperson         Personnel?              @relation(fields: [salespersonId], references: [id], onDelete: Restrict)
  correctionOf        Sale?                   @relation("SaleCorrections", fields: [correctionOfId], references: [id], onDelete: Restrict)
  corrections         Sale[]                  @relation("SaleCorrections")
  originalBackjobs    Backjob[]               @relation("BackjobOriginalSale")
  chargeBackjobs      Backjob[]               @relation("BackjobChargeSale")
  warranties          CustomerWarranty[]
  correctedBy         User?                   @relation("SaleCorrectedBy", fields: [correctedById], references: [id])
  lines               SaleLine[]
  accountingReview    SaleAccountingReview?
  correctionRequests  SaleCorrectionRequest[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([locationId, receiptBooklet, manualReceiptNumber])
  @@index([locationId, postedAt])
  @@index([postedById])
  @@index([salespersonId, postedAt])
  @@index([customerId])
  @@index([correctionOfId])
  @@index([correctedById])
}

model SaleLine {
  id              String  @id @default(cuid())
  saleId          String
  productId       String
  productItemCode String
  productName     String
  quantity        Int
  unitPrice       Decimal @db.Decimal(12, 2)
  warrantyDurationMonths Int?
  warrantyExpiresAt DateTime?
  sale            Sale    @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product         Product @relation(fields: [productId], references: [id])
  backjobs        Backjob[]
  warranties      CustomerWarranty[]
  backjobItems    BackjobItem[]

  @@index([saleId])
  @@index([productId])
}

model SaleAccountingReview {
  id                             String                      @id @default(cuid())
  saleId                         String                      @unique
  status                         AccountingReviewStatus      @default(UNVERIFIED)
  mismatchCategory               String?
  notes                          String?                     @db.Text
  comparisonJson                 String?                     @db.Text
  receiptPhotoKey                String?
  receiptPhotoType               String?
  receiptOcrStatus               String?
  receiptOcrJson                 String?                     @db.Text
  receiptOcrError                String?                     @db.Text
  receiptOcrAt                   DateTime?
  evidencePendingNotifiedAt      DateTime?
  evidenceReminderSentAt         DateTime?
  evidenceUploadedAt             DateTime?
  resolutionAction               AccountingResolutionAction?
  resolutionNote                 String?                     @db.Text
  resolvedById                   String?
  resolvedAt                     DateTime?
  reviewedById                   String?
  reviewedAt                     DateTime?
  verifiedAt                     DateTime?
  branchResponse                 BranchMismatchResponse?
  branchResponseNote             String?                     @db.Text
  branchReplacementReceiptNumber String?
  branchRespondedById            String?
  branchRespondedAt              DateTime?
  sale                           Sale                        @relation(fields: [saleId], references: [id], onDelete: Restrict)
  reviewedBy                     User?                       @relation("SaleReviewedBy", fields: [reviewedById], references: [id])
  resolvedBy                     User?                       @relation("SaleResolvedBy", fields: [resolvedById], references: [id])
  branchRespondedBy              User?                       @relation("SaleBranchRespondedBy", fields: [branchRespondedById], references: [id])

  @@index([status])
  @@index([verifiedAt])
  @@index([reviewedById])
  @@index([resolvedById])
  @@index([branchRespondedById])
  @@index([evidenceReminderSentAt, receiptPhotoKey])
}

model SaleCorrectionRequest {
  id             String                           @id @default(cuid())
  saleId         String
  reason         SaleCorrectionRequestReason
  note           String                           @db.Text
  status         SaleCorrectionRequestStatus      @default(PENDING)
  resolution     SaleCorrectionRequestResolution?
  resolutionNote String?                          @db.Text
  requestedById  String
  requestedAt    DateTime                         @default(now())
  resolvedById   String?
  resolvedAt     DateTime?
  sale           Sale                             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  requestedBy    User                             @relation("SaleCorrectionRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  resolvedBy     User?                            @relation("SaleCorrectionResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt

  @@index([saleId, status])
  @@index([requestedById])
  @@index([resolvedById])
}

model Notification {
  id               String                   @id @default(cuid())
  cursor           BigInt                   @unique @default(autoincrement())
  userId           String
  title            String
  description      String                   @db.Text
  type             NotificationType         @default(INFO)
  relatedType      NotificationRelatedType?
  relatedId        String?
  relatedReference String?
  readAt           DateTime?
  createdAt        DateTime                 @default(now())
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushAttempts     PushDeliveryAttempt[]

  @@index([userId, readAt, createdAt])
  @@index([userId, cursor])
  @@index([relatedType, relatedId])
}

model PushSubscription {
  id        String                @id @default(cuid())
  userId    String
  endpoint  String                @unique @db.Text
  p256dh    String
  auth      String
  userAgent String?               @db.Text
  isActive  Boolean               @default(true)
  failedAt  DateTime?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  attempts  PushDeliveryAttempt[]

  @@index([userId, isActive])
}

model PushDeliveryAttempt {
  id             String             @id @default(cuid())
  notificationId String
  subscriptionId String
  status         PushDeliveryStatus
  error          String?            @db.Text
  attemptedAt    DateTime           @default(now())
  notification   Notification       @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  subscription   PushSubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([notificationId, subscriptionId])
  @@index([subscriptionId, attemptedAt])
}

model OfflineDeviceActivation {
  id               String              @id @default(cuid())
  deviceId         String              @unique
  locationId       String
  activatedById    String
  label            String?
  status           OfflineDeviceStatus @default(ACTIVE)
  lastAuthorizedAt DateTime            @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([locationId, status])
}

model OfflineSyncOperation {
  id             String            @id @default(cuid())
  deviceId       String
  idempotencyKey String
  operationType  String
  requestHash    String
  status         OfflineSyncStatus
  actorId        String
  locationId     String
  saleId         String?
  resultJson     String?           @db.Text
  createdAt      DateTime          @default(now())
  processedAt    DateTime?

  @@unique([deviceId, idempotencyKey])
  @@index([locationId, status])
}

model OfflineSaleSubmission {
  id              String            @id @default(cuid())
  syncOperationId String            @unique
  deviceId        String
  idempotencyKey  String
  locationId      String
  submittedById   String
  payloadJson     String            @db.Text
  status          OfflineSyncStatus
  statusReason    String?           @db.Text
  saleId          String?
  occurredAt      DateTime
  createdAt       DateTime          @default(now())

  @@index([locationId, status])
  @@index([submittedById, createdAt])
}

model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
